<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Windows XP Boot</title>
  <style>
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      background: #000;
      font-family: "Segoe UI", Tahoma, sans-serif;
      user-select: none;
    }

    body {
      display: flex;
      align-items: center;
      justify-content: center;
      background:
        linear-gradient(to bottom, rgba(255,255,255,0.02), rgba(255,255,255,0.01) 50%, rgba(255,255,255,0.02)),
        #000;
    }

    #boot-screen {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #000;
      z-index: 9999999;
      overflow: hidden;
    }

    #boot-screen::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(255,255,255,0.03), rgba(255,255,255,0.01) 50%, rgba(255,255,255,0.03));
      background-size: 100% 6px;
      opacity: 0.35;
      pointer-events: none;
    }

    .boot-wrap {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transform: translateY(-18px);
      z-index: 1;
    }

    .logo-wrap {
      position: relative;
      width: min(72vw, 820px);
      height: min(46vw, 500px);
      filter: drop-shadow(0 18px 18px rgba(0,0,0,0.2));
      margin-bottom: 18px;
    }

    .panel {
      position: absolute;
      border-radius: 20px 40px 20px 40px;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08), inset 0 -30px 20px rgba(0,0,0,0.10);
      overflow: hidden;
    }

    .panel::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, rgba(255,255,255,0.26), rgba(255,255,255,0.04) 22%, rgba(0,0,0,0.02) 60%, rgba(0,0,0,0.10));
      pointer-events: none;
    }

    .panel-orange {
      left: 30px;
      top: 24px;
      width: 430px;
      height: 250px;
      background: linear-gradient(135deg, #f56e1e 0%, #eb5620 12%, #d54714 100%);
      transform: rotate(-7deg) skewX(-6deg) skewY(0deg);
      border-radius: 26px 26px 20px 32px;
    }

    .panel-green {
      right: 18px;
      top: 28px;
      width: 430px;
      height: 250px;
      background: linear-gradient(135deg, #64be6a 0%, #4dac41 18%, #3a8f32 100%);
      transform: rotate(8deg) skewX(6deg);
      border-radius: 28px 24px 32px 18px;
    }

    .panel-blue {
      left: 30px;
      bottom: 14px;
      width: 430px;
      height: 250px;
      background: linear-gradient(135deg, #1f63d7 0%, #1f56d0 18%, #0c3eaa 100%);
      transform: rotate(-6deg) skewX(-3deg);
      border-radius: 26px 30px 18px 26px;
    }

    .panel-yellow {
      right: 18px;
      bottom: 14px;
      width: 430px;
      height: 250px;
      background: linear-gradient(135deg, #f5c31e 0%, #f0b300 16%, #d49b00 100%);
      transform: rotate(7deg) skewX(5deg);
      border-radius: 22px 28px 30px 18px;
    }

    .brand {
      text-align: center;
      line-height: 1;
      color: rgba(255,255,255,0.95);
    }

    .microsoft-tag {
      font-size: 14px;
      letter-spacing: 0.35px;
      color: rgba(255,255,255,0.9);
      margin-bottom: 8px;
      font-weight: 400;
    }

    .windows-line {
      display: inline-flex;
      align-items: flex-end;
      gap: 10px;
      position: relative;
    }

    .windows-word {
      font-size: clamp(42px, 6vw, 66px);
      letter-spacing: -2px;
      font-weight: 700;
      line-height: 0.9;
      color: #fff;
    }

    .xp-word {
      font-size: clamp(24px, 3vw, 30px);
      font-weight: 900;
      letter-spacing: -1px;
      color: #ff8a1d;
      line-height: 1;
      font-family: "Arial Black", Impact, sans-serif;
      transform: translateY(-6px);
      text-shadow: 0 0 12px rgba(255,140,0,0.18);
    }

    .boot-progress {
      position: relative;
      width: 180px;
      height: 16px;
      margin-top: 28px;
      border: 2px solid #8d8d8d;
      background: #000;
      overflow: hidden;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05);
    }

    .boot-progress-fill {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    .boot-progress-fill::before {
      content: "";
      position: absolute;
      left: -42%;
      top: 0;
      width: 32%;
      height: 100%;
      background: linear-gradient(to right, #1456c7 0%, #2b7ef6 20%, #7cb7ff 45%, #2b7ef6 70%, #1456c7 100%);
      box-shadow: 0 0 12px rgba(74, 143, 255, 0.8), inset 0 0 0 1px rgba(255,255,255,0.2);
      animation: xpLoad 2.4s cubic-bezier(0.25, 0.1, 0.25, 1) infinite;
    }

    @keyframes xpLoad {
      0% { left: -42%; }
      100% { left: 112%; }
    }

    .boot-footer {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 26px;
      font-size: 12px;
      color: rgba(255,255,255,0.74);
      letter-spacing: 0.15px;
      z-index: 1;
    }

    .boot-footer .right {
      font-weight: 700;
      opacity: 0.9;
    }

    #desktop {
      position: fixed;
      inset: 0;
      display: none;
      background: linear-gradient(rgba(0,0,0,0.12), rgba(0,0,0,0.08)),
                  url('https://www.windowslatest.com/wp-content/uploads/2024/10/Windows-XP-Bliss-Wallpaper-4K-scaled.jpg') center/cover no-repeat;
    }

    .desktop-panel {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 20px;
      font-weight: 600;
      text-shadow: 2px 2px 8px rgba(0,0,0,0.35);
    }
  </style>
</head>
<body>
  <div id="boot-screen">
    <div class="boot-wrap">
      <div class="logo-wrap" aria-hidden="true">
        <div class="panel panel-orange"></div>
        <div class="panel panel-green"></div>
        <div class="panel panel-blue"></div>
        <div class="panel panel-yellow"></div>
      </div>

      <div class="brand">
        <div class="microsoft-tag">microsoft TM</div>
        <div class="windows-line">
          <span class="windows-word">Windows</span>
          <span class="xp-word">XP</span>
        </div>
      </div>

      <div class="boot-progress" aria-label="Loading">
        <div class="boot-progress-fill"></div>
      </div>
    </div>

    <div class="boot-footer">
      <div class="left">Copyright © Microsoft Corporation</div>
      <div class="right">Microsoft</div>
    </div>
  </div>

  <div id="desktop">
    <div class="desktop-panel">Windows XP desktop</div>
  </div>

  <script>
    setTimeout(() => {
      const boot = document.getElementById('boot-screen');
      const desktop = document.getElementById('desktop');
      if (boot) boot.style.display = 'none';
      if (desktop) desktop.style.display = 'block';
    }, 2800);
  </script>
</body>
</html>
