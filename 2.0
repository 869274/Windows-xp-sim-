  <div id="taskbar">
    <button id="start-button" onclick="toggleStartMenu()" data-tooltip="Click here to open apps">
      <span class="start-logo" aria-hidden="true">
        <span class="start-pane pane-red"></span>
        <span class="start-pane pane-green"></span>
        <span class="start-pane pane-blue"></span>
        <span class="start-pane pane-yellow"></span>
      </span>
      <span class="start-text">start</span>
    </button>
    <div id="open-apps-container"></div>
    <div id="taskbar-right">
      <button class="stream-toggle-tb" id="s-btn-mode" type="button" onclick="return false;" aria-label="hi">🔰🌐⛔️</button>
      <span id="digital-clock" data-tooltip="Local server time">00:00:00 PM</span>
    </div>
  </div>

  <script>
    setTimeout(() => {
      const boot = document.getElementById('boot-screen');
      if (boot) boot.style.display = 'none';
    }, 2800);

    let startOpen = false;
    function toggleStartMenu() {
      startOpen = !startOpen;
      document.getElementById('start-menu').style.display = startOpen ? 'block' : 'none';
    }
    function toggleShutdownDialog(show) {
      if (startOpen) toggleStartMenu();
      document.getElementById('shutdown-dialog').style.display = show ? 'block' : 'none';
    }

    let topZ = 100;
    const openApps = {};
    function openWindow(id) {
      const win = document.getElementById(id);
      if (!win) return;
      win.style.display = 'block';
      setTimeout(() => win.classList.add('window-open'), 10);
      win.style.zIndex = ++topZ;
      openApps[id] = true;
      renderTaskbarApps();
    }
    function closeWindow(id) {
      const win = document.getElementById(id);
      if (!win) return;
      win.classList.remove('window-open');
      setTimeout(() => win.style.display = 'none', 150);
      delete openApps[id];
      renderTaskbarApps();
    }
    function minimizeWindow(id) {
      const win = document.getElementById(id);
      if (win) win.style.display = 'none';
    }
    function maximizeWindow(id) {
      const win = document.getElementById(id);
      if (win) win.classList.toggle('maximized');
    }
    function renderTaskbarApps() {
      const container = document.getElementById('open-apps-container');
      container.innerHTML = '';
      for (const id in openApps) {
        const btn = document.createElement('button');
        btn.className = 'taskbar-app-btn';
        const name = id.replace('win-', '').toUpperCase();
        btn.textContent = name;
        btn.onclick = () => {
          const win = document.getElementById(id);
          if (win.style.display === 'none') {
            win.style.display = 'block';
            win.style.zIndex = ++topZ;
          } else {
            win.style.zIndex = ++topZ;
          }
        };
        container.appendChild(btn);
      }
    }

    const touchCursor = document.getElementById('touch-cursor');
    function updateTouchCursor(e) {
      if (e.pointerType === 'touch' || e.pointerType === 'pen') {
        document.body.classList.add('touch-cursor-visible');
        touchCursor.style.left = e.clientX + 'px';
        touchCursor.style.top = e.clientY + 'px';
      } else {
        document.body.classList.remove('touch-cursor-visible');
      }
    }
    document.addEventListener('pointermove', updateTouchCursor);
    document.addEventListener('pointerdown', updateTouchCursor);
    document.addEventListener('pointerleave', () => {
      document.body.classList.remove('touch-cursor-visible');
    });

    document.querySelectorAll('.window').forEach(win => {
      const header = win.querySelector('.window-header');
      if (!header) return;
      let dragState = null;

      function endDrag() {
        if (!dragState) return;
        dragState = null;
        header.style.cursor = 'grab';
        win.classList.remove('dragging');
      }

      header.addEventListener('pointerdown', (e) => {
        if (e.target.closest('button')) return;
        if (e.pointerType === 'mouse' && e.button !== 0) return;

        const rect = win.getBoundingClientRect();
        dragState = {
          win,
          startX: e.clientX,
          startY: e.clientY,
          origLeft: rect.left,
          origTop: rect.top
        };

        header.setPointerCapture?.(e.pointerId);
        win.classList.add('dragging');
        header.style.cursor = 'grabbing';

        e.preventDefault();
      });

      header.addEventListener('pointermove', (e) => {
        if (!dragState) return;

        const dx = e.clientX - dragState.startX;
        const dy = e.clientY - dragState.startY;

        let nextLeft = dragState.origLeft + dx;
        let nextTop = dragState.origTop + dy;

        if (nextTop < 0) nextTop = 0;
        if (nextLeft < 0) nextLeft = 0;

        win.style.left = nextLeft + 'px';
        win.style.top = nextTop + 'px';
      });

      header.addEventListener('pointerup', endDrag);
      header.addEventListener('pointercancel', endDrag);
      header.addEventListener('lostpointercapture', endDrag);
    });

    function changeTheme(theme) {
      document.body.className = document.body.className.replace(/theme-\w+/g, theme);
    }
    function changeBg(bg) {
      document.body.className = document.body.className.replace(/bg-\w+/g, bg);
    }

    const folderData = {
      docs: ['top', 'top', 'top'],
      downloads: ['top', 'top', 'top'],
      games: ['top', 'top', 'top'],
      logs: ['top', 'top', 'top']
    };
    function loadFolder(folderKey) {
      const main = document.getElementById('explorer-content');
      main.innerHTML = '';
      folderData[folderKey].forEach(item => {
        const div = document.createElement('div');
        div.className = 'explorer-item';
        div.innerHTML = '<div class=\"explorer-item-icon\">📄</div>' + item;
        div.onclick = () => alert('Opening simulated file: ' + item);
        main.appendChild(div);
      });
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>\"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      }[char]));
    }

    function renderSearchResults(query) {
      const safeQuery = escapeHtml(query.trim() || 'Search');
      const view = document.getElementById('browser-viewport');
      const results = [
        safeQuery,
        'Search results for ' + safeQuery,
        'Related pages about ' + safeQuery,
        'How to use ' + safeQuery,
        'More info on ' + safeQuery
      ];

      view.innerHTML = `
        <div class="search-page">
          <div class="search-header">Results for: "${safeQuery}"</div>
          <ol class="search-results">
            ${results.map((item, index) => `<li>${index + 1}. ${item}</li>`).join('')}
          </ol>
        </div>
      `;
    }

    function goSuperWium() {
      const input = document.getElementById('browser-url-bar');
      const query = input.value.trim();
      if (!query) return;
      const lower = query.toLowerCase();
      if (lower.startsWith('http://') || lower.startsWith('https://')) {
        document.getElementById('browser-viewport').innerHTML = `
          <div class="search-page">
            <div class="search-header">Page Loaded</div>
            <ol class="search-results">
              <li>1. ${escapeHtml(query)}</li>
              <li>2. Opened link: ${escapeHtml(query)}</li>
              <li>3. Page preview ready</li>
            </ol>
          </div>
        `;
        return;
      }
      renderSearchResults(query);
    }

    document.getElementById('browser-go').addEventListener('click', goSuperWium);
    document.getElementById('browser-url-bar').addEventListener('keydown', function (e) {
      if (e.key === 'Enter') goSuperWium();
    });

    function loadWeb(site) {
      const view = document.getElementById('browser-viewport');
      const bar = document.getElementById('browser-url-bar');
      if (site === 'home') {
        bar.value = 'https://superwium.net/v4';
        view.innerHTML = '<h3>SuperWium 4.0 Core Engine</h3><p>You are on the main secure index.</p>';
      } else if (site === 'roblox') {
        bar.value = 'https://roblox.com/studio_hub';
        view.innerHTML = '<h3>Roblox Developer Portal</h3><p style="color:#00aa00; font-weight:bold;">Synced with Brookhaven Military Base.</p><p>Status: Ready for streaming.</p>';
      } else if (site === 'youtube') {
        bar.value = 'https://studio.youtube.com/channel/c00lkidd_v2yt';
        view.innerHTML = '<h3>Channel Statistics</h3><p>Current community progress:</p><h4 style="color:#ff0055;">Subscribers: 90 / 100 (10 left for the special release)</h4>';
      } else if (site === 'news') {
        bar.value = 'https://retrocore-news.org/xp_systems';
        view.innerHTML = '<h3>RetroCore News Portal</h3><p>Virtual environment development has reached version 5.0 with full support for phonk music.</p>';
      } else if (site === 'changelog') {
        bar.value = 'https://retrocore.net/changelog5';
        view.innerHTML = '<h3>RetroCore 5.0 Ultimate Highlights</h3><ul><li>Interactive CMD integration</li><li>Submenus added to the start button</li><li>Colorful border effects and live streamer overlays</li></ul>';
      }
    }

    const canvas = document.getElementById('snakeGameCanvas');
    const ctx = canvas.getContext('2d');
    const boxSize = 10;
    let snake, food, score, maxScore, snakeDir, gameInterval, snakeSpeed;
    let snakeMode = 'normal';
    let touchStart = null;

    maxScore = Number(localStorage.getItem('retroSnakeMax')) || 0;
    document.getElementById('s-high').textContent = maxScore;

    function startSnake() {
      clearInterval(gameInterval);
      score = 0;
      snakeDir = 'RIGHT';
      document.getElementById('s-score').textContent = score;
      snake = [
        { x: 15 * boxSize, y: 10 * boxSize },
        { x: 14 * boxSize, y: 10 * boxSize },
        { x: 13 * boxSize, y: 10 * boxSize }
      ];
      spawnSnakeFood();
      snakeSpeed = snakeMode === 'turbo' ? 45 : 100;
      gameInterval = setInterval(gameStep, snakeSpeed);
    }

    function spawnSnakeFood() {
      food = {
        x: Math.floor(Math.random() * 32) * boxSize,
        y: Math.floor(Math.random() * 22) * boxSize
      };
      for (let i = 0; i < snake.length; i++) {
        if (snake[i].x === food.x && snake[i].y === food.y) {
          spawnSnakeFood();
          return;
        }
      }
    }

    function setSnakeMode(mode) {
      snakeMode = mode;
      document.getElementById('s-mode-lbl').textContent = mode.toUpperCase();
      startSnake();
    }

    document.addEventListener('keydown', e => {
      const key = e.key.toLowerCase();
      if (key === 'arrowleft' || e.keyCode === 37) setSnakeDirection('LEFT');
      if (key === 'arrowup' || e.keyCode === 38) setSnakeDirection('UP');
      if (key === 'arrowright' || e.keyCode === 39) setSnakeDirection('RIGHT');
      if (key === 'arrowdown' || e.keyCode === 40) setSnakeDirection('DOWN');
    });

    function setSnakeDirection(dir) {
      const opposite = {
        LEFT: 'RIGHT',
        RIGHT: 'LEFT',
        UP: 'DOWN',
        DOWN: 'UP'
      };
      if (snakeDir && opposite[dir] === snakeDir) return;
      snakeDir = dir;
    }

    function gameStep() {
      ctx.fillStyle = '#0d0d0d';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      for (let i = 0; i < snake.length; i++) {
        ctx.fillStyle = i == 0 ? '#398a23' : '#ffffff';
        ctx.fillRect(snake[i].x, snake[i].y, boxSize, boxSize);
      }

      ctx.fillStyle = '#ff3333';
      ctx.fillRect(food.x, food.y, boxSize, boxSize);

      let headX = snake[0].x;
      let headY = snake[0].y;

      if (snakeDir === 'LEFT') headX -= boxSize;
      if (snakeDir === 'UP') headY -= boxSize;
      if (snakeDir === 'RIGHT') headX += boxSize;
      if (snakeDir === 'DOWN') headY += boxSize;

      if (snakeMode === 'infinite') {
        if (headX < 0) headX = canvas.width - boxSize;
        if (headX >= canvas.width) headX = 0;
        if (headY < 0) headY = canvas.height - boxSize;
        if (headY >= canvas.height) headY = 0;
      }

      const nextHead = { x: headX, y: headY };
      if (snakeMode !== 'infinite' && (headX < 0 || headX >= canvas.width || headY < 0 || headY >= canvas.height)) {
        endSnakeGame();
        return;
      }

      if (snake.some(s => s.x === nextHead.x && s.y === nextHead.y)) {
        if (snake[0].x !== nextHead.x || snake[0].y !== nextHead.y) {
          endSnakeGame();
          return;
        }
      }

      if (headX === food.x && headY === food.y) {
        score++;
        document.getElementById('s-score').textContent = score;
        playOscillatorSound(880, 60);
        if (score > maxScore) {
          maxScore = score;
          localStorage.setItem('retroSnakeMax', maxScore);
          document.getElementById('s-high').textContent = maxScore;
        }
        snake.unshift(nextHead);
        spawnSnakeFood();
      } else {
        snake.pop();
        snake.unshift(nextHead);
      }
    }

    function endSnakeGame() {
      clearInterval(gameInterval);
      playOscillatorSound(180, 350);
      ctx.fillStyle = 'orange';
      ctx.font = '14pt monospace';
      ctx.fillText('CANCELLED / GAME OVER', 60, 110);
    }

    function bindSnakeTouchControls() {
      document.querySelectorAll('.pad-btn').forEach(btn => {
        btn.addEventListener('pointerdown', (e) => {
          e.preventDefault();
          setSnakeDirection(btn.dataset.dir);
        });
      });

      document.getElementById('snakeGameCanvas').addEventListener('touchstart', (e) => {
        if (e.touches.length) {
          const t = e.touches[0];
          touchStart = { x: t.clientX, y: t.clientY };
        }
      }, { passive: true });

      document.getElementById('snakeGameCanvas').addEventListener('touchend', (e) => {
        if (!touchStart) return;
        const touch = e.changedTouches[0];
        const dx = touch.clientX - touchStart.x;
        const dy = touch.clientY - touchStart.y;

        if (Math.abs(dx) > Math.abs(dy)) {
          setSnakeDirection(dx > 0 ? 'RIGHT' : 'LEFT');
        } else {
          setSnakeDirection(dy > 0 ? 'DOWN' : 'UP');
        }
        touchStart = null;
      }, { passive: true });
    }
    bindSnakeTouchControls();

    const tracks = ['Bass_Phonk_Special.mp3', 'Hyper_Synthwave_XP.mp3', 'AuraOS_Symphony_6.mp3'];
    let trackIdx = 0; let mTimer; let mBarVal = 0;
    function controlMusic(action) {
      const title = document.getElementById('track-title');
      const status = document.getElementById('track-status');
      const bar = document.getElementById('m-bar');

      if (action === 'play') {
        title.textContent = tracks[trackIdx];
        status.textContent = 'Status: Playing...';
        clearInterval(mTimer);
        mTimer = setInterval(() => {
          mBarVal = (mBarVal + 5) % 105;
          bar.style.width = mBarVal + '%';
        }, 400);
      } else if (action === 'pause' || action === 'stop') {
        status.textContent = 'Status: Stopped';
        clearInterval(mTimer);
        if (action === 'stop') {
          mBarVal = 0;
          bar.style.width = '0%';
        }
      } else if (action === 'next') {
        trackIdx = (trackIdx + 1) % tracks.length;
        controlMusic('play');
      } else if (action === 'prev') {
        trackIdx = (trackIdx - 1 + tracks.length) % tracks.length;
        controlMusic('play');
      }
    }

    function handleCmd(event) {
      if (event.key === 'Enter') {
        const field = document.getElementById('cmd-input-field');
        const history = document.getElementById('cmd-history');
        const val = field.value.toLowerCase().trim();
        let output = '';

        if (val === 'help') {
          output = "Commands:\n version - OS version\n stream_status - Stream status\n virus_test - Malware demo\n snake_stats - Game record\n clear - Clear terminal\n help - List commands";
        } else if (val === 'version') {
          output = 'RetroCore Windows 5.0 [Ultimate Stream Edition 2026]';
        } else if (val === 'stream_status') {
          output = 'OFF | Start from the taskbar';
        } else if (val === 'virus_test') {
          output = 'Launching lab call...';
          setTimeout(() => runVirusStage1(), 1000);
        } else if (val === 'snake_stats') {
          output = 'Best score: ' + maxScore;
        } else if (val === 'clear') {
          history.textContent = '';
          field.value = '';
          return;
        } else if (!val) {
          output = '';
        } else {
          output = 'Unknown command: ' + field.value;
        }

        history.innerHTML += '<div><br> C:\\Angelo_OS> ' + field.value + '<br>' + output.replace(/\n/g, '<br>') + '</div>';
        field.value = '';
        const box = document.querySelector('.cmd-box');
        box.scrollTop = box.scrollHeight;
      }
    }

    function playOscillatorSound(freq, duration) {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        const ctxAudio = new AudioCtx();
        const oscillator = ctxAudio.createOscillator();
        const gain = ctxAudio.createGain();
        oscillator.type = 'square';
        oscillator.frequency.value = freq;
        gain.gain.value = 0.03;
        oscillator.connect(gain);
        gain.connect(ctxAudio.destination);
        oscillator.start();
        setTimeout(() => {
          oscillator.stop();
          oscillator.disconnect();
          gain.disconnect();
          ctxAudio.close();
        }, duration);
      } catch (err) {
        console.log('Audio not available:', err);
      }
    }

    function runVirusStage1() {
      const box = document.getElementById('virus-lab-body');
      box.innerHTML = '<h4>Stage 1: Signature Scan</h4><p>Analyzing the desktop layer...</p><button onclick="runVirusStage2()" style="padding:8px 16px; font-weight:bold; cursor:pointer; background:linear-gradient(to bottom,#ff4d4d,#cc0000); color:white; border:1px solid #990000;">Continue</button>';
      playOscillatorSound(440, 180);
    }
    function runVirusStage2() {
      const box = document.getElementById('virus-lab-body');
      box.innerHTML = '<h4>Stage 2: Visual Override</h4><p>Injecting graphical pulses...</p><button onclick="runVirusStage3()" style="padding:8px 16px; font-weight:bold; cursor:pointer; background:linear-gradient(to bottom,#ffb347,#d96b00); color:white; border:1px solid #8f4a00;">Override</button>';
      document.getElementById('virus-ransom-box').style.display = 'block';
      playOscillatorSound(660, 140);
    }
    function runVirusStage3() {
      const box = document.getElementById('virus-lab-body');
      box.innerHTML = '<h4>Stage 3: Security Layer Drift</h4><p>Bypassing warning signal...</p><button onclick="runVirusStage4()" style="padding:8px 16px; font-weight:bold; cursor:pointer; background:linear-gradient(to bottom,#a2c8ff,#4a79d8); color:white; border:1px solid #2d4f9f;">Bypass</button>';
      playOscillatorSound(800, 120);
    }
    function runVirusStage4() {
      document.getElementById('virus-ransom-box').style.display = 'none';
      document.getElementById('bsod').style.display = 'block';
      const win = document.getElementById('win-virus');
      win.classList.add('vibrate-active');
      setTimeout(() => win.classList.remove('vibrate-active'), 800);
    }
    function triggerBsodStage4() {
      runVirusStage4();
    }

    function updateClock() {
      const now = new Date();
      const time = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      document.getElementById('digital-clock').textContent = time;
    }
    setInterval(updateClock, 1000);
    updateClock();
    startSnake();

    const recycleBin = document.getElementById('recycle-bin-desktop');
    let dragState = null;

    function getPointerPosition(e) {
      return { x: e.clientX, y: e.clientY };
    }

    document.querySelectorAll('.desktop-icon').forEach(icon => {
      icon.addEventListener('pointerdown', (e) => {
        if (icon.id === 'recycle-bin-desktop') return;

        const rect = icon.getBoundingClientRect();
        const pointer = getPointerPosition(e);

        dragState = {
          icon,
          offsetX: pointer.x - rect.left,
          offsetY: pointer.y - rect.top,
          startX: pointer.x,
          startY: pointer.y
        };

        const ghost = icon.cloneNode(true);
        ghost.classList.add('dragging');
        ghost.style.position = 'fixed';
        ghost.style.left = rect.left + 'px';
        ghost.style.top = rect.top + 'px';
        ghost.style.width = rect.width + 'px';
        ghost.style.height = rect.height + 'px';
        ghost.style.zIndex = '999999';
        ghost.style.pointerEvents = 'none';
        ghost.style.opacity = '0.9';
        ghost.setAttribute('id', 'desktop-drag-ghost');
        document.body.appendChild(ghost);

        dragState.ghost = ghost;
        icon.classList.add('dragging');
        icon.setPointerCapture?.(e.pointerId);

        e.preventDefault();
      });

      icon.addEventListener('pointermove', (e) => {
        if (!dragState || dragState.icon !== icon) return;

        const pointer = getPointerPosition(e);
        const ghost = dragState.ghost;

        ghost.style.left = (pointer.x - dragState.offsetX) + 'px';
        ghost.style.top = (pointer.y - dragState.offsetY) + 'px';

        const recycleRect = recycleBin.getBoundingClientRect();
        const isOverRecycle = (
          pointer.x >= recycleRect.left &&
          pointer.x <= recycleRect.right &&
          pointer.y >= recycleRect.top &&
          pointer.y <= recycleRect.bottom
        );

        recycleBin.style.filter = isOverRecycle ? 'brightness(1.3) drop-shadow(0 0 12px rgba(255,255,255,0.9))' : 'none';
      });

      icon.addEventListener('pointerup', handleIconDrop);
      icon.addEventListener('pointercancel', handleIconDrop);
      icon.addEventListener('lostpointercapture', handleIconDrop);
    });

    function handleIconDrop(e) {
      if (!dragState) return;

      const icon = dragState.icon;
      const ghost = dragState.ghost;
      const pointer = getPointerPosition(e);

      const recycleRect = recycleBin.getBoundingClientRect();
      const isOverRecycle =
        pointer.x >= recycleRect.left &&
        pointer.x <= recycleRect.right &&
        pointer.y >= recycleRect.top &&
        pointer.y <= recycleRect.bottom;

      if (ghost) ghost.remove();
      icon.classList.remove('dragging');

      if (isOverRecycle) {
        icon.classList.add('trashed');
        icon.style.display = 'none';
        recycleBin.style.filter = 'none';
        setTimeout(() => { alert('Folder moved to Recycle Bin'); }, 50);
      } else {
        recycleBin.style.filter = 'none';
      }

      dragState = null;
    }

    document.addEventListener('pointerup', () => {
      if (dragState) {
        handleIconDrop({ clientX: dragState.startX, clientY: dragState.startY });
      }
    });
  </script>
</body>
</html>
