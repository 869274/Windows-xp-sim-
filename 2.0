<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RetroCore Windows 5.0 – Ultimate Edition</title>
  <style>
    * { box-sizing: border-box; }
    html, body {
      margin: 0;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
      font-family: 'Tahoma', 'Segoe UI', sans-serif;
      font-size: 11px;
      user-select: none;
      -webkit-user-select: none;
      touch-action: manipulation;
      cursor: default;
      background: #000;
    }

    body.theme-blue {
      --xp-blue: #245edb;
      --xp-header: linear-gradient(to bottom, #245edb 0%, #3f8cf3 9%, #245edb 18%, #1b4ca3 100%);
      --xp-taskbar: linear-gradient(to bottom, #245edb 0%, #3f8cf3 9%, #245edb 18%, #1b4ca3 92%, #163b7e 100%);
      --xp-border: #245edb;
    }
    body.theme-silver {
      --xp-blue: #8c8c9e;
      --xp-header: linear-gradient(to bottom, #cfd0d8 0%, #ffffff 20%, #b4b7c7 40%, #8c8c9e 100%);
      --xp-taskbar: linear-gradient(to bottom, #b4b7c7 0%, #ebecef 10%, #b4b7c7 20%, #7e8293 90%, #585a67 100%);
      --xp-border: #8c8c9e;
    }
    body.theme-olive {
      --xp-blue: #616e41;
      --xp-header: linear-gradient(to bottom, #a2b473 0%, #cbd99d 10%, #a2b473 25%, #616e41 100%);
      --xp-taskbar: linear-gradient(to bottom, #a2b473 0%, #cbd99d 10%, #a2b473 20%, #525e35 90%, #3d4626 100%);
      --xp-border: #616e41;
    }

    body.bg-bliss {
      background-image: url("https://www.windowslatest.com/wp-content/uploads/2024/10/Windows-XP-Bliss-Wallpaper-4K-scaled.jpg");
      background-size: cover;
      background-position: center center;
      background-repeat: no-repeat;
      background-color: #5d9ce6;
      position: relative;
    }
    body.bg-bliss::before,
    body.bg-bliss::after {
      display: none;
    }
    body.bg-dark { background: #111111; }
    body.bg-retro { background: #008080; }

    [data-tooltip] { position: relative; }
    [data-tooltip]::after {
      content: attr(data-tooltip);
      position: absolute;
      bottom: 130%;
      left: 50%;
      transform: translateX(-50%);
      background: #ffffe1;
      color: #000;
      border: 1px solid #000;
      padding: 3px 6px;
      font-size: 10px;
      white-space: nowrap;
      z-index: 999999;
      display: none;
      box-shadow: 2px 2px 4px rgba(0,0,0,0.2);
      border-radius: 2px;
    }
    [data-tooltip]:hover::after { display: block; }

    #touch-cursor {
      position: fixed;
      left: 0;
      top: 0;
      width: 18px;
      height: 22px;
      pointer-events: none;
      z-index: 2147483647;
      opacity: 0;
      transform: translate(-1px, -1px);
      transition: opacity 0.08s ease;
      filter: drop-shadow(0 2px 2px rgba(0,0,0,0.35));
    }
    #touch-cursor::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 15px;
      height: 19px;
      background: rgba(255,255,255,0.96);
      border: 1px solid rgba(0,0,0,0.85);
      clip-path: polygon(0% 0%, 68% 0%, 68% 34%, 100% 34%, 54% 100%, 54% 64%, 0% 64%);
      box-shadow: inset 0 0 0 1px rgba(0,0,0,0.05);
    }
    #touch-cursor::after {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 0;
      height: 0;
      display: none;
    }

    body.touch-cursor-visible #touch-cursor { opacity: 1; }

    #boot-screen {
      position: fixed; inset: 0; background: #000; z-index: 9999999;
      display: flex; align-items: center; justify-content: center; color: #fff;
      font-family: "Segoe UI", Tahoma, sans-serif; overflow: hidden;
    }
    #boot-screen::before {
      content: "";
      position: absolute; inset: 0;
      background:
        linear-gradient(to bottom, rgba(255,255,255,0.02), rgba(255,255,255,0.01) 50%, rgba(255,255,255,0.02));
      background-size: 100% 6px;
      opacity: 0.2;
      pointer-events: none;
    }
    .boot-wrap {
      position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center;
      transform: translateY(-14px); z-index: 1;
    }
    .xp-logo {
      position: relative; width: 120px; height: 90px; margin-bottom: 20px;
      transform: skewX(-8deg); filter: drop-shadow(0 0 12px rgba(255,255,255,0.08));
    }
    .xp-logo .pane {
      position: absolute; width: 48px; height: 38px; border-radius: 5px 12px 5px 12px; overflow: hidden;
    }
    .xp-logo .pane.red { background: linear-gradient(135deg, #f3432d 0%, #be2011 100%); left: 0; top: 0; }
    .xp-logo .pane.green { background: linear-gradient(135deg, #85cf3d 0%, #498d22 100%); left: 51px; top: 0; border-radius: 12px 5px 12px 5px; }
    .xp-logo .pane.blue { background: linear-gradient(135deg, #1b7fe8 0%, #0d4bb3 100%); left: 0; top: 42px; border-radius: 12px 5px 12px 5px; }
    .xp-logo .pane.yellow { background: linear-gradient(135deg, #f2c229 0%, #d19206 100%); left: 51px; top: 42px; border-radius: 5px 12px 5px 12px; }
    .boot-brand { text-align: center; line-height: 1; }
    .microsoft-label {
      font-size: 13px; letter-spacing: 0.35px; color: rgba(255,255,255,0.92); margin-bottom: 4px; font-weight: 400;
    }
    .windows-line {
      display: inline-flex; align-items: flex-end; gap: 10px; position: relative;
    }
    .windows-word { font-size: 58px; letter-spacing: -2px; font-weight: 700; color: #ffffff; line-height: 0.9; }
    .xp-word {
      font-size: 28px; font-weight: 900; letter-spacing: -1px; color: #ff7b1d; line-height: 1;
      font-family: "Arial Black", Impact, sans-serif; transform: translateY(-6px);
      text-shadow: 0 0 12px rgba(255,140,0,0.18);
    }
    .boot-progress {
      position: relative; width: 170px; height: 14px; margin-top: 28px; border: 2px solid #8d8d8d; background: #000; overflow: hidden;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05);
    }
    .boot-progress-fill { position: absolute; inset: 0; overflow: hidden; }
    .boot-progress-fill::before {
      content: "";
      position: absolute; left: -42%; top: 0; width: 32%; height: 100%;
      background: linear-gradient(to right, #1456c7 0%, #2b7ef6 20%, #7cb7ff 45%, #2b7ef6 70%, #1456c7 100%);
      box-shadow: 0 0 12px rgba(74, 143, 255, 0.8), inset 0 0 0 1px rgba(255,255,255,0.2);
      animation: xpLoad 2.4s cubic-bezier(0.25, 0.1, 0.25, 1) infinite;
    }
    @keyframes xpLoad { 0% { left: -42%; } 100% { left: 112%; } }

    .boot-footer {
      position: absolute; left: 0; right: 0; bottom: 18px; display: flex; justify-content: space-between; align-items: center;
      padding: 0 30px; font-size: 12px; color: rgba(255,255,255,0.74); letter-spacing: 0.15px; z-index: 1;
    }
    .boot-footer .right { font-weight: 700; opacity: 0.9; }

    #desktop {
      width: 100%; height: calc(100vh - 30px); padding: 15px; display: flex; flex-direction: column; flex-wrap: wrap;
      align-content: flex-start; gap: 18px; position: relative; z-index: 5;
    }
    .desktop-icon {
      width: 90px; text-align: center; color: white; cursor: pointer; display: flex; flex-direction: column; align-items: center;
      text-shadow: 2px 2px 3px rgba(0,0,0,0.9); font-weight: 500; padding: 5px; border: 1px solid transparent; border-radius: 3px;
      position: relative;
      user-select: none;
      touch-action: none;
    }
    .desktop-icon:hover { background-color: rgba(255,255,255,0.08); border-color: transparent; }
    .desktop-icon .desktop-folder-icon {
      display: inline-block; width: 42px; height: 38px; font-size: 46px; line-height: 1; margin-bottom: 6px;
      transform: translateY(2px); filter: drop-shadow(0 2px 0 rgba(0,0,0,0.25));
    }
    .desktop-icon span:last-child {
      display: block; line-height: 1.15; font-size: 12px;
    }
    .desktop-icon.dragging {
      opacity: 0.45;
      transform: scale(1.05);
      z-index: 99999;
    }
    .desktop-icon.trashed {
      display: none;
    }

    .window {
      width: 500px; height: 360px; background: #f1f0e8; border: 3px solid var(--xp-border); border-top-left-radius: 7px; border-top-right-radius: 7px;
      position: absolute; z-index: 100; display: none; box-shadow: 4px 6px 22px rgba(0,0,0,0.4); transform: scale(0.95); opacity: 0;
      transition: transform 0.15s ease-out, opacity 0.15s ease-out;
    }
    .window.window-open { transform: scale(1); opacity: 1; }
    .window-header {
      background: var(--xp-header); color: white; font-weight: bold; padding: 5px 8px; font-size: 11px; display: flex;
      justify-content: space-between; align-items: center; cursor: grab; touch-action: none; height: 26px;
    }
    .window-header:active { cursor: grabbing; }
    .window-title-area { display: flex; align-items: center; gap: 6px; }
    .window-title-icon { width: 14px; height: 14px; background: #fff; border-radius: 2px; display: inline-block; font-size: 8px; text-align: center; line-height: 14px; color: #333; }
    .window-controls { display: flex; gap: 2px; }
    .window-controls button {
      color: white; font-weight: bold; font-size: 9px; border-radius: 2px; width: 22px; height: 18px; cursor: pointer;
      border: 1px solid rgba(0,0,0,0.3); padding: 0; box-shadow: inset 0 1px 0 rgba(255,255,255,0.3);
    }
    .win-btn-min, .win-btn-max { background: linear-gradient(to bottom, #3c7be6, #1640a3); }
    .win-btn-close { background: linear-gradient(to bottom, #e76446 0%, #b83314 100%); }
    .win-btn-close:hover { background: #ff3300; }
    .window-body {
      padding: 10px; font-size: 11px; color: black; background: #fff; height: calc(100% - 26px); overflow: auto; position: relative;
    }
    .window.maximized { width: 100% !important; height: calc(100vh - 30px) !important; top: 0 !important; left: 0 !important; }

    .explorer-layout { display: flex; height: 100%; }
    .explorer-sidebar { width: 130px; background: #7b9ede; border-right: 1px solid #4b6da3; padding: 8px; color: white; }
    .explorer-main { flex-grow: 1; padding: 10px; display: flex; flex-wrap: wrap; gap: 15px; background: #fff; align-content: flex-start; }
    .sidebar-folder { padding: 6px; cursor: pointer; border-radius: 3px; font-weight: bold; margin-bottom: 5px; }
    .sidebar-folder:hover { background-color: rgba(255,255,255,0.2); }
    .explorer-item { width: 70px; text-align: center; cursor: pointer; font-size: 10px; }
    .explorer-item img { width: 32px; height: 32px; display: block; margin: 0 auto 4px; }

    .explorer-item-icon {
      width: 32px;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 4px;
      border: 1px solid #d9a100;
      background: linear-gradient(to bottom, #f8d64b 0%, #f0c22c 100%);
      color: #1a1a1a;
      font-weight: bold;
      font-size: 10px;
      border-radius: 4px;
      line-height: 1;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.6);
    }

    .folder-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 18px;
      margin-right: 6px;
      border: 1px solid #d9a100;
      background: linear-gradient(to bottom, #f8d64b 0%, #f0c22c 100%);
      color: #1a1a1a;
      font-size: 8px;
      font-weight: bold;
      border-radius: 3px;
      vertical-align: middle;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.6);
    }

    .nav-bar { display: flex; gap: 4px; margin-bottom: 8px; background: #f0f0f0; padding: 5px; border-bottom: 1px solid #ccc; align-items: center; }
    .nav-input { flex-grow: 1; border: 1px solid #7f9db9; padding: 3px 6px; font-size: 11px; }
    .nav-btn { background: #fff; border: 1px solid #a0a0a0; border-radius: 3px; cursor: pointer; padding: 3px 10px; font-weight: bold; }
    .web-content { width: 100%; height: calc(100% - 40px); background: #fff; border: 1px solid #999; padding: 12px; overflow-y: auto; }

    .search-page {
      padding: 16px;
      font-family: Tahoma, sans-serif;
      background: #fff;
      height: 100%;
      overflow-y: auto;
    }
    .search-header {
      font-weight: bold;
      font-size: 16px;
      margin-bottom: 12px;
      color: #1c2c6b;
    }
    .search-results {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .search-results li {
      padding: 10px 12px;
      border-bottom: 1px solid #dfeaf7;
      font-size: 12px;
      color: #1c2c6b;
    }
    .search-results li:first-child {
      font-weight: bold;
      background: #eef5ff;
    }

    #snakeGameCanvas { border: 2px solid var(--xp-border); background: #0d0d0d; display: block; margin: 0 auto; }
    .snake-dashboard { display: flex; justify-content: space-between; font-weight: bold; background: #f0f0f0; padding: 6px; border-radius: 4px; margin-top: 6px; }

    .ctrl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .ctrl-card { border: 1px solid #ccc; padding: 10px; border-radius: 4px; background: #fdfdfd; }
    .ctrl-card h5 { margin: 0 0 6px 0; font-size: 11px; color: #245edb; }

    .player-box { background: #222; color: #00ff00; padding: 12px; border-radius: 6px; font-family: monospace; text-align: center; }
    .player-controls { display: flex; justify-content: center; gap: 10px; margin-top: 10px; }
    .player-btn { background: #444; border: 1px solid #666; color: white; padding: 4px 10px; cursor: pointer; font-size: 10px; font-family: monospace; }
    .player-btn:hover { background: #666; }
    .music-progress { width: 100%; background: #444; height: 6px; margin-top: 10px; border-radius: 3px; overflow: hidden; }
    .music-bar { width: 0%; height: 100%; background: #00ff00; transition: width 0.5s linear; }

    .notepad-textarea { width: 100%; height: calc(100% - 30px); border: 1px solid #ccc; resize: none; font-family: Courier, monospace; padding: 5px; font-size: 12px; }

    .cmd-box { background: #000; color: #fff; font-family: monospace; height: 100%; padding: 5px; overflow-y: auto; }
    .cmd-output { white-space: pre-wrap; margin-bottom: 5px; line-height: 1.3; }
    .cmd-input-line { display: flex; }
    .cmd-prompt { color: #00ff00; font-weight: bold; margin-right: 5px; }
    .cmd-field { background: transparent; border: none; color: white; font-family: monospace; outline: none; flex-grow: 1; font-size: 11px; }

    #start-menu {
      position: fixed; bottom: 30px; left: 0; width: 280px; background: #fff; border: 2px solid var(--xp-border);
      border-top-right-radius: 5px; box-shadow: 3px -3px 20px rgba(0,0,0,0.4); display: none; z-index: 99999;
    }
    .start-header { background: var(--xp-header); color: white; padding: 10px; font-weight: bold; display: flex; align-items: center; gap: 8px; font-size: 12px; }
    .start-header img { width: 24px; height: 24px; border-radius: 50%; border: 1px solid white; }
    .start-menu-list { padding: 4px 0; background: #fff; position: relative; }
    .start-menu-item { padding: 8px 15px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; color: #333; position: relative; }
    .start-menu-item:hover { background-color: #316ac5; color: white; }
    .start-submenu {
      position: absolute; left: 100%; top: 0; width: 180px; background: white; border: 2px solid var(--xp-border); display: none;
      box-shadow: 3px 3px 10px rgba(0,0,0,0.2); z-index: 100000; padding: 4px 0;
    }
    .start-menu-item:hover > .start-submenu { display: block; }
    .submenu-item { padding: 6px 12px; color: #333; cursor: pointer; }
    .submenu-item:hover { background: #316ac5; color: white; }
    .start-footer { background: #d3e5fa; padding: 6px; text-align: right; border-top: 1px solid #a2c1e8; }
    .shutdown-btn { background: linear-gradient(to bottom, #e76446, #b83314); color: white; border: 1px solid #7a1b07; padding: 4px 10px; font-weight: bold; cursor: pointer; border-radius: 3px; }

    #shutdown-dialog {
      position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 320px; background: #5a7edc;
      border: 3px solid #0011a0; border-radius: 6px; padding: 15px; color: white; text-align: center; z-index: 999998; display: none;
      box-shadow: 0px 10px 30px rgba(0,0,0,0.6);
    }
    .shutdown-options { display: flex; justify-content: space-around; margin-top: 15px; }
    .shutdown-opt-btn { background: #f0f0f0; border: 2px solid #333; border-radius: 4px; padding: 6px 12px; font-weight: bold; cursor: pointer; color: black; }
    .shutdown-opt-btn:hover { background: #ddd; }

    #taskbar {
      background: var(--xp-taskbar); position: fixed; bottom: 0; left: 0; width: 100%; height: 30px; display: flex; align-items: center; z-index: 99999;
      box-shadow: inset 0 1px 1px rgba(255,255,255,0.4);
    }
    #start-button {
      height: 100%; width: 100px; background: linear-gradient(to bottom, #60af47, #398a23); border-top-right-radius: 7px; border-bottom-right-radius: 7px;
      color: white; font-weight: bold; font-style: italic; font-size: 13pt; display: flex; align-items: center; justify-content: center; gap: 8px;
      cursor: pointer; text-shadow: 1px 1px 2px #225511; border: none; padding: 0 10px 0 8px;
    }
    #start-button:active { background: linear-gradient(to bottom, #398a23, #296419); }

    .start-logo {
      position: relative; width: 16px; height: 14px; flex-shrink: 0; display: inline-block; transform: skewX(-10deg);
      filter: drop-shadow(0 0 1px rgba(0,0,0,0.5));
    }
    .start-pane { position: absolute; width: 7px; height: 6px; border-radius: 2px; }
    .pane-red { background: linear-gradient(135deg, #ef4c2d, #c42512); top: 0; left: 0; }
    .pane-green { background: linear-gradient(135deg, #7ecb35, #4d8f20); top: 0; left: 7px; }
    .pane-blue { background: linear-gradient(135deg, #1b73dc, #1248a8); top: 6px; left: 0; }
    .pane-yellow { background: linear-gradient(135deg, #ffc12b, #d59b0a); top: 6px; left: 7px; }
    .start-text { line-height: 1; display: inline-block; transform: translateY(-1px); }

    #open-apps-container { display: flex; gap: 4px; margin-left: 10px; align-items: center; }
    .taskbar-app-btn {
      background: linear-gradient(to bottom, #3c7be6, #1f4994); color: white; border: 1px solid #112a59; border-radius: 3px; padding: 2px 8px; height: 24px;
      cursor: pointer; font-size: 10px; max-width: 110px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .taskbar-app-btn.active-app { background: #1e4287; font-weight: bold; border-color: #fff; }

    #taskbar-right {
      margin-left: auto; background: linear-gradient(to bottom, #0f69e4, #0046b7); color: white; height: 100%; display: flex; align-items: center; gap: 8px;
      padding: 0 12px; font-size: 10px; border-left: 1px solid #0c3374;
    }
    .stream-toggle-tb {
      background: linear-gradient(to bottom, #2ea0ff 0%, #0d6ad9 100%);
      border: 1px solid #0a4ba3;
      color: #fff;
      padding: 2px 10px;
      font-weight: bold;
      cursor: pointer;
      border-radius: 2px;
      font-size: 12px;
      line-height: 1;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.25);
    }

    @keyframes windowVibrate { 0% { transform: translate(1px, 1px) rotate(0deg); } 50% { transform: translate(-2px, -1px) rotate(1deg); } 100% { transform: translate(2px, -1px) rotate(-1deg); } }
    .vibrate-active { animation: windowVibrate 0.1s infinite !important; }

    #virus-ransom-box {
      position: fixed; top: 40%; left: 50%; transform: translate(-50%, -50%); width: 360px; background: #fff; border: 4px solid #cc0000;
      z-index: 999997; box-shadow: 0 0 30px rgba(255,0,0,0.8); display: none; padding: 15px; text-align: center;
    }
    #bsod {
      position: fixed; inset: 0; background-color: #0000aa; color: white; font-family: 'Courier New', monospace; padding: 50px; font-size: 12pt;
      z-index: 9999999; display: none; line-height: 1.5;
    }

    .snake-mobile-controls {
      display: none;
      justify-content: center;
      align-items: center;
      gap: 10px;
      margin-top: 12px;
    }
    .snake-pad {
      display: grid;
      grid-template-columns: repeat(3, 42px);
      grid-template-rows: repeat(3, 42px);
      gap: 5px;
      user-select: none;
    }
    .pad-btn {
      background: linear-gradient(to bottom, #a7b9ff, #6a7fdd);
      border: 1px solid #33469d;
      color: #fff; border-radius: 8px; font-weight: bold; font-size: 18px;
      touch-action: manipulation; user-select: none;
    }
    .pad-btn:active { filter: brightness(1.15); }

    .pad-up { grid-column: 2; grid-row: 1; }
    .pad-left { grid-column: 1; grid-row: 2; }
    .pad-down { grid-column: 2; grid-row: 2; }
    .pad-right { grid-column: 3; grid-row: 2; }
    .pad-center { grid-column: 2; grid-row: 3; }

    @media (max-width: 900px) {
      .snake-mobile-controls { display: flex; }
      #snakeGameCanvas { width: min(86vw, 300px); height: auto; }
      .window { width: min(86vw, 420px); }
      .desktop-icon { width: 74px; }
      .desktop-icon span:last-child { font-size: 11px; }
    }
  </style>
</head>
<body class="theme-blue bg-bliss">
  <div id="touch-cursor"></div>

  <div id="boot-screen">
    <div class="boot-wrap">
      <div class="xp-logo" aria-hidden="true">
        <span class="pane red"></span>
        <span class="pane green"></span>
        <span class="pane blue"></span>
        <span class="pane yellow"></span>
      </div>

      <div class="boot-brand">
        <div class="microsoft-label">microsoft TM</div>
        <div class="windows-line">
          <span class="windows-word">Windows</span>
          <span class="xp-word">XP</span>
        </div>
      </div>

      <div class="boot-progress" aria-label="Loading">
        <div class="boot-progress-fill"></div>
